{"steps":{"19.125":[{"path":"src/main/webapp/html/tutorial.html","oldPath":"src/main/webapp/html/tutorial.html","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":817,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">org.springframework.samples.petclinic.web.ClinicController</span>"},{"type":"add","old":null,"new":818,"text":"\t\tis an annotation-driven, POJO <em>MultiActionController</em>"},{"type":"add","old":null,"new":819,"text":"\t\tthat is used to handle simple display-oriented URLs."},{"type":"add","old":null,"new":820,"text":"\t  </li>"},{"type":"add","old":null,"new":821,"text":"\t  <li>"},{"type":"add","old":null,"new":822,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">org.springframework.samples.petclinic.web.FindOwnersForm</span>"},{"type":"add","old":null,"new":823,"text":"\t\tis an annotation-driven, POJO <em>Form</em> controller that is used to search for"},{"type":"add","old":null,"new":824,"text":"\t\t<strong>Owner</strong>s by last name."},{"type":"add","old":null,"new":825,"text":"\t  </li>"},{"type":"add","old":null,"new":826,"text":"\t  <li>"},{"type":"add","old":null,"new":827,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">org.springframework.samples.petclinic.web.AddOwnerForm</span>"},{"type":"add","old":null,"new":828,"text":"\t\tis an annotation-driven, POJO <em>Form</em> controller that is used to add a new <strong>Owner</strong>"},{"type":"add","old":null,"new":829,"text":"\t\tto the system."},{"type":"add","old":null,"new":830,"text":"\t  </li>"},{"type":"add","old":null,"new":831,"text":"\t  <li>"},{"type":"add","old":null,"new":832,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">org.springframework.samples.petclinic.web.EditOwnerForm</span>"},{"type":"add","old":null,"new":833,"text":"\t\tis an annotation-driven, POJO <em>Form</em> controller that is used to edit an existing <strong>Owner</strong>."},{"type":"add","old":null,"new":834,"text":"\t\tA copy of the existing <strong>Owner</strong> is used for editing."},{"type":"add","old":null,"new":835,"text":"\t  </li>"},{"type":"add","old":null,"new":836,"text":"\t  <li>"},{"type":"add","old":null,"new":837,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">org.springframework.samples.petclinic.web.AddPetForm</span>"},{"type":"add","old":null,"new":838,"text":"\t\tis an annotation-driven, POJO <em>Form</em> controller that is used to add a new <strong>Pet</strong>"},{"type":"add","old":null,"new":839,"text":"\t\tto an existing <strong>Owner</strong>."},{"type":"add","old":null,"new":840,"text":"\t  </li>"},{"type":"add","old":null,"new":841,"text":"\t  <li>"},{"type":"add","old":null,"new":842,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">org.springframework.samples.petclinic.web.EditPetForm</span>"},{"type":"add","old":null,"new":843,"text":"\t\tis an annotation-driven, POJO <em>Form</em> controller that is used to edit an existing <strong>Pet</strong>."},{"type":"add","old":null,"new":844,"text":"\t\tA copy of the existing <strong>Pet</strong> is used for editing."},{"type":"add","old":null,"new":845,"text":"\t  </li>"},{"type":"add","old":null,"new":846,"text":"\t  <li>"},{"type":"add","old":null,"new":847,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">org.springframework.samples.petclinic.web.AddVisitForm</span>"},{"type":"add","old":null,"new":848,"text":"\t\tis an annotation-driven, POJO <em>Form</em> controller that is used to add a new <strong>Visit</strong>"},{"type":"add","old":null,"new":849,"text":"\t\tto an existing <strong>Pet</strong>."},{"type":"add","old":null,"new":850,"text":"\t  </li>"},{"type":"add","old":null,"new":851,"text":"\t</ul>"},{"type":"add","old":null,"new":852,"text":""},{"type":"add","old":null,"new":853,"text":"\t<h3>Logical Views &amp; Implemented Use Cases</h3>"},{"type":"add","old":null,"new":854,"text":""},{"type":"add","old":null,"new":855,"text":"\t<ul>"},{"type":"add","old":null,"new":856,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">welcome</span> is"},{"type":"add","old":null,"new":857,"text":"\t\tthe \"home\" screen. It provides links to display a list of all vets,"},{"type":"add","old":null,"new":858,"text":"\t\tfind an owner, or view documentation.</li>"},{"type":"add","old":null,"new":859,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">vets</span> displays"},{"type":"add","old":null,"new":860,"text":"\t\tall vets and their specialties.</li>"},{"type":"add","old":null,"new":861,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">findOwners</span>"},{"type":"add","old":null,"new":862,"text":"\t\tis used to find owners by last name.</li>"},{"type":"add","old":null,"new":863,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">findOwnersRedirect</span>"},{"type":"add","old":null,"new":864,"text":"\t\tredirects to findOwner.</li>"},{"type":"add","old":null,"new":865,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">selectOwner</span>"},{"type":"add","old":null,"new":866,"text":"\t\tallows user to select from a list of multiple owners with the same last"},{"type":"add","old":null,"new":867,"text":"\t\tname.</li>"},{"type":"add","old":null,"new":868,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">owner</span> displays"},{"type":"add","old":null,"new":869,"text":"\t\ta owner's data and a list of the owner's pets and their data.</li>"},{"type":"add","old":null,"new":870,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">ownerRedirect</span>"},{"type":"add","old":null,"new":871,"text":"\t\tredirects to owner.</li>"},{"type":"add","old":null,"new":872,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">owner</span> supports"},{"type":"add","old":null,"new":873,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">AddOwnerForm</span>"},{"type":"add","old":null,"new":874,"text":"\t\tand <span style=\"font-weight: bold; font-style: italic;\">EditOwnerForm</span></li>"},{"type":"add","old":null,"new":875,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">pet</span> supports"},{"type":"add","old":null,"new":876,"text":"\t  \t<span style=\"font-weight: bold; font-style: italic;\">AddPetForm</span>"},{"type":"add","old":null,"new":877,"text":"\t\tand <span style=\"font-weight: bold; font-style: italic;\">web.EditPetForm</span></li>"},{"type":"add","old":null,"new":878,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">visit</span> supports"},{"type":"add","old":null,"new":879,"text":"\t  \t<span style=\"font-weight: bold; font-style: italic;\">AddVisitForm</span></li>"},{"type":"add","old":null,"new":880,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">dataAccessFailure</span>"},{"type":"add","old":null,"new":881,"text":"\t\tdisplays a stacktrace</li>"},{"type":"add","old":null,"new":882,"text":"\t</ul>"},{"type":"add","old":null,"new":883,"text":""},{"type":"add","old":null,"new":884,"text":"\t<h3>Java Server Pages</h3>"}]}],"19.126":[{"path":"src/main/webapp/html/tutorial.html","oldPath":"src/main/webapp/html/tutorial.html","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":885,"text":""},{"type":"add","old":null,"new":886,"text":"\t<ul>"},{"type":"add","old":null,"new":887,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">index.jsp</span>"},{"type":"add","old":null,"new":888,"text":"\t    redirects to the \"welcome\" page.</li>"},{"type":"add","old":null,"new":889,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">includes.jsp</span> is"},{"type":"add","old":null,"new":890,"text":"\t\tstatically included in <span style=\"text-decoration: underline;\">all</span>"},{"type":"add","old":null,"new":891,"text":"\t\tJSP's used in the application. It specifies the taglibs that are in use.</li>"},{"type":"add","old":null,"new":892,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">header.jsp</span> and"},{"type":"add","old":null,"new":893,"text":"\t  \t<span style=\"font-style: italic; font-weight: bold;\">footer.jsp</span>"},{"type":"add","old":null,"new":894,"text":"\t\tdisplay info common to virtually all pages. Spring also supplies"},{"type":"add","old":null,"new":895,"text":"\t\tsupport for the integration of <a href=\"http://www.lifl.fr/%7Edumoulin/tiles\">Tiles</a>"},{"type":"add","old":null,"new":896,"text":"\t\t(included in Struts) but this is not used in PetClinic.</li>"},{"type":"add","old":null,"new":897,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">dataAccessFailure.jsp</span>"},{"type":"add","old":null,"new":898,"text":"\t  \tis the error page configured via"},{"type":"add","old":null,"new":899,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">SimpleMappingExceptionResolver</span>,"},{"type":"add","old":null,"new":900,"text":"\t\twhich displays a stack trace and normally wouldn't be used in a production"},{"type":"add","old":null,"new":901,"text":"\t\tversion of an application. It can be seen in action by entering a URL of"},{"type":"add","old":null,"new":902,"text":"\t\t\"editOwner.do\" or \"editPet.do\" with an invalid request parameter, for example:"},{"type":"add","old":null,"new":903,"text":"\t\t<a href=\"http://localhost:8080/org.springframework.samples.petclinic/owner.do?ownerId=-1\">/petclinic/owner.do?ownerId=-1</a>."},{"type":"add","old":null,"new":904,"text":"\t\tThe handlers for these URLs normally expect to see a respective \"ownerId\" or \"petId\""},{"type":"add","old":null,"new":905,"text":"\t\trequest parameter corresponding to an Owner or Pet in the database. Thus,"},{"type":"add","old":null,"new":906,"text":"\t\tthese handlers will throw a <strong>DataAccessException</strong> when such"},{"type":"add","old":null,"new":907,"text":"\t\ta request parameter is provided which references a non-existing entity.</li>"},{"type":"add","old":null,"new":908,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">uncaughtException.jsp</span>"},{"type":"add","old":null,"new":909,"text":"\t\tis the <span style=\"font-weight: bold; font-style: italic;\">web.xml</span> configured"},{"type":"add","old":null,"new":910,"text":"\t\t\"error-page\". It displays a stack trace and normally wouldn't be used"},{"type":"add","old":null,"new":911,"text":"\t\tin a production version of an application. It can be seen in action by"},{"type":"add","old":null,"new":912,"text":"\t\tentering a URL of \"editOwner.do\" or \"editPet.do\" without a valid request"},{"type":"add","old":null,"new":913,"text":"\t\tparameter, for example:"},{"type":"add","old":null,"new":914,"text":"\t\t<a href=\"http://localhost:8080/org.springframework.samples.petclinic/owner.do\">/petclinic/owner.do</a>."},{"type":"add","old":null,"new":915,"text":"\t\tThe handlers for these URLs normally expect to see a respective \"ownerId\" or \"petId\""},{"type":"add","old":null,"new":916,"text":"\t\trequest parameter and throw a <strong>ServletException</strong> when such"},{"type":"add","old":null,"new":917,"text":"\t\ta request parameter is not found.</li>"},{"type":"add","old":null,"new":918,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">welcome.jsp</span> implements"},{"type":"add","old":null,"new":919,"text":"\t  \t<span style=\"font-weight: bold; font-style: italic;\">welcome</span>.</li>"},{"type":"add","old":null,"new":920,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">vets.jsp</span> implements"},{"type":"add","old":null,"new":921,"text":"\t  \t<span style=\"font-weight: bold; font-style: italic;\">vets</span>.</li>"},{"type":"add","old":null,"new":922,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">findOwners.jsp</span> implements"},{"type":"add","old":null,"new":923,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">findOwners</span>.</li>"},{"type":"add","old":null,"new":924,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">owners.jsp</span> implements"},{"type":"add","old":null,"new":925,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">selectOwner</span>.</li>"},{"type":"add","old":null,"new":926,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">owner.jsp</span> implements"},{"type":"add","old":null,"new":927,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">owner</span>.</li>"},{"type":"add","old":null,"new":928,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">ownerForm.jsp</span> implements"},{"type":"add","old":null,"new":929,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">ownerForm</span>.</li>"},{"type":"add","old":null,"new":930,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">petForm.jsp</span> implements"},{"type":"add","old":null,"new":931,"text":"\t  \t<span style=\"font-weight: bold; font-style: italic;\">petForm</span>.</li>"},{"type":"add","old":null,"new":932,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">visitForm.jsp</span> implements"},{"type":"add","old":null,"new":933,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">visitForm</span>.</li>"},{"type":"add","old":null,"new":934,"text":"\t</ul>"},{"type":"add","old":null,"new":935,"text":""},{"type":"add","old":null,"new":936,"text":"\t<p>"},{"type":"add","old":null,"new":937,"text":"\t\tThe following items should be noted regarding the web application"},{"type":"add","old":null,"new":938,"text":"\t\timplementation design:"},{"type":"add","old":null,"new":939,"text":"\t</p>"},{"type":"add","old":null,"new":940,"text":""},{"type":"add","old":null,"new":941,"text":"\t<ol>"},{"type":"add","old":null,"new":942,"text":"\t  <li>all JSP's are stored under <span style=\"font-weight: bold; font-style: italic;\">/WEB-INF/jsp</span> except"},{"type":"add","old":null,"new":943,"text":"\t\tfor <span style=\"font-weight: bold; font-style: italic;\">index.jsp</span> which"},{"type":"add","old":null,"new":944,"text":"\t\tis the configured \"welcome-file\"</li>"},{"type":"add","old":null,"new":945,"text":"\t  <li>The use of JSP technology in the application is not exposed to"},{"type":"add","old":null,"new":946,"text":"\t\tthe user, i.e., the end user never sees a URL ending in"},{"type":"add","old":null,"new":947,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">\".jsp\".</span></li>"},{"type":"add","old":null,"new":948,"text":"\t  <li>By convention, all URL's in the application ending in"},{"type":"add","old":null,"new":949,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">\".do\"</span> are"},{"type":"add","old":null,"new":950,"text":"\t\thandled by web application controllers. Static html pages ending in"},{"type":"add","old":null,"new":951,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">\".html\"</span>, such as"},{"type":"add","old":null,"new":952,"text":"\t\tJavadoc, will be directly served to the end user.</li>"}]}],"19.127":[{"path":"src/main/webapp/html/tutorial.html","oldPath":"src/main/webapp/html/tutorial.html","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":953,"text":"\t  <li>The results of all form entries are handled using browser round"},{"type":"add","old":null,"new":954,"text":"\t\ttrip redirection to minimize possible end user confusion.</li>"},{"type":"add","old":null,"new":955,"text":"\t  <li>All pages are extremely simple JSP implementations that focus"},{"type":"add","old":null,"new":956,"text":"\t\tonly on providing the necessary functionality.</li>"},{"type":"add","old":null,"new":957,"text":"\t  <li>References to <span style=\"font-weight: bold;\">Entity</span> objects"},{"type":"add","old":null,"new":958,"text":"\t\tare passed around in the application by supplying the object's <code>ID</code>"},{"type":"add","old":null,"new":959,"text":"\t\tas a request parameter.</li>"},{"type":"add","old":null,"new":960,"text":"\t</ol>"},{"type":"add","old":null,"new":961,"text":""},{"type":"add","old":null,"new":962,"text":"\t<h3>Testing</h3>"},{"type":"add","old":null,"new":963,"text":"\t<ul>"},{"type":"add","old":null,"new":964,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">org.springframework.samples.petclinic.OwnerTests</span>"},{"type":"add","old":null,"new":965,"text":"\t  \tis a simple JUnit 4 based TestCase that supports Business Rule #1.</li>"},{"type":"add","old":null,"new":966,"text":"\t  <li><span style=\"font-weight: bold; font-style: italic;\">org.springframework.samples.petclinic.AbstractClinicTests</span>"},{"type":"add","old":null,"new":967,"text":"\t\tis a JUnit 4 based TestCase requiring a live database connection that is"},{"type":"add","old":null,"new":968,"text":"\t\tused to confirm correct operation of the database access objects in the"},{"type":"add","old":null,"new":969,"text":"\t\tvarious implementations of the <strong>Clinic</strong> interface."},{"type":"add","old":null,"new":970,"text":"\t\t&quot;AbstractClinicTests-context.xml&quot; declares a common"},{"type":"add","old":null,"new":971,"text":"\t\t<strong>javax.sql.DataSource</strong>. Subclasses specify additional"},{"type":"add","old":null,"new":972,"text":"\t\tcontext locations which declare a"},{"type":"add","old":null,"new":973,"text":"\t\t<strong>org.springframework.transaction.PlatformTransactionManager</strong>"},{"type":"add","old":null,"new":974,"text":"\t\tand a concrete implementation of <strong>Clinic</strong>."},{"type":"add","old":null,"new":975,"text":"\t\t<p>"},{"type":"add","old":null,"new":976,"text":"\t\t\tAbstractClinicTests extends"},{"type":"add","old":null,"new":977,"text":"\t\t\t<strong>AbstractTransactionalJUnit4SpringContextTests</strong>,"},{"type":"add","old":null,"new":978,"text":"\t\t\tone of the valuable testing support classes provided by the"},{"type":"add","old":null,"new":979,"text":"\t\t\t<em>Spring TestContext Framework</em> found in the"},{"type":"add","old":null,"new":980,"text":"\t\t\t<code>org.springframework.test.context</code> package. The"},{"type":"add","old":null,"new":981,"text":"\t\t\tannotation-driven configuration used here represents best practice for"},{"type":"add","old":null,"new":982,"text":"\t\t\tintegration tests with Spring. Note, however, that"},{"type":"add","old":null,"new":983,"text":"\t\t\tAbstractTransactionalJUnit4SpringContextTests serves only as a convenience"},{"type":"add","old":null,"new":984,"text":"\t\t\tfor extension. For example, if you do not wish for your test classes to be"},{"type":"add","old":null,"new":985,"text":"\t\t\ttied to a Spring-specific class hierarchy, you may configure your tests with"},{"type":"add","old":null,"new":986,"text":"\t\t\tannotations such as <strong>@ContextConfiguration</strong>,"},{"type":"add","old":null,"new":987,"text":"\t\t\t<strong>@TestExecutionListeners</strong>, <strong>@Transactional</strong>, etc."},{"type":"add","old":null,"new":988,"text":"\t\t</p>"},{"type":"add","old":null,"new":989,"text":"\t\t<p>"},{"type":"add","old":null,"new":990,"text":"\t\t\tAbstractClinicTests and its subclasses benefit from the following services"},{"type":"add","old":null,"new":991,"text":"\t\t\tprovided by the Spring TestContext Framework:"},{"type":"add","old":null,"new":992,"text":"\t\t</p>"},{"type":"add","old":null,"new":993,"text":"\t\t<ul>"},{"type":"add","old":null,"new":994,"text":"\t\t\t<li><strong>Spring IoC container caching</strong> which spares us"},{"type":"add","old":null,"new":995,"text":"\t\t\t\tunnecessary set up time between test execution.</li>"},{"type":"add","old":null,"new":996,"text":"\t\t\t<li><strong>Dependency Injection</strong> of test fixture instances,"},{"type":"add","old":null,"new":997,"text":"\t\t\t\tmeaning that we don't need to perform application context lookups. See the"},{"type":"add","old":null,"new":998,"text":"\t\t\t\tuse of <strong>@Autowired</strong> on the <code>clinic</code> instance"},{"type":"add","old":null,"new":999,"text":"\t\t\t\tvariable, which uses autowiring <em>by type</em>. As an alternative, we"},{"type":"add","old":null,"new":1000,"text":"\t\t\t\tcould annotate <code>clinic</code> with JSR 250's"},{"type":"add","old":null,"new":1001,"text":"\t\t\t\t<strong>@Resource</strong> to achieve dependency injection <em>by name</em>."},{"type":"add","old":null,"new":1002,"text":"\t\t\t\t<em>(see: <strong>@ContextConfiguration</strong>,"},{"type":"add","old":null,"new":1003,"text":"\t\t\t\t<strong>DependencyInjectionTestExecutionListener</strong>)</em></li>"},{"type":"add","old":null,"new":1004,"text":"\t\t\t<li><strong>Transaction management</strong>, meaning each test method is"},{"type":"add","old":null,"new":1005,"text":"\t\t\t\texecuted in its own transaction, which is automatically rolled back by"},{"type":"add","old":null,"new":1006,"text":"\t\t\t\tdefault. Thus, even if tests insert or otherwise change database state, there"},{"type":"add","old":null,"new":1007,"text":"\t\t\t\tis no need for a teardown or cleanup script."},{"type":"add","old":null,"new":1008,"text":"\t\t\t\t<em>(see: <strong>@TransactionConfiguration</strong>,"},{"type":"add","old":null,"new":1009,"text":"\t\t\t\t<strong>@Transactional</strong>, <strong>TransactionalTestExecutionListener</strong>)</em></li>"},{"type":"add","old":null,"new":1010,"text":"\t\t\t<li><strong>Useful inherited protected fields</strong>, such as a"},{"type":"add","old":null,"new":1011,"text":"\t\t\t\t<strong>SimpleJdbcTemplate</strong> that can be used to verify"},{"type":"add","old":null,"new":1012,"text":"\t\t\t\tdatabase state after test operations or to verify the results of"},{"type":"add","old":null,"new":1013,"text":"\t\t\t\tqueries performed by application code. An"},{"type":"add","old":null,"new":1014,"text":"\t\t\t\t<strong>ApplicationContext</strong> is also inherited and can be"},{"type":"add","old":null,"new":1015,"text":"\t\t\t\tused for explicit bean lookup if necessary."},{"type":"add","old":null,"new":1016,"text":"\t\t\t\t<em>(see: <strong>AbstractJUnit4SpringContextTests</strong>,"},{"type":"add","old":null,"new":1017,"text":"\t\t\t\t<strong>AbstractTransactionalJUnit4SpringContextTests</strong>)</em></li>"},{"type":"add","old":null,"new":1018,"text":"\t\t</ul>"},{"type":"add","old":null,"new":1019,"text":"\t\t<p>"},{"type":"add","old":null,"new":1020,"text":"\t\t\tThe <em>Spring TestContext Framework</em> and related unit and"}]}],"19.128":[{"path":"src/main/webapp/html/tutorial.html","oldPath":"src/main/webapp/html/tutorial.html","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":1021,"text":"\t\t\tintegration testing support classes are shipped in"},{"type":"add","old":null,"new":1022,"text":"\t\t\t<code>spring-test.jar</code>."},{"type":"add","old":null,"new":1023,"text":"\t\t</p>"},{"type":"add","old":null,"new":1024,"text":""},{"type":"add","old":null,"new":1025,"text":"\t  </li>"},{"type":"add","old":null,"new":1026,"text":"\t</ul>"},{"type":"add","old":null,"new":1027,"text":""},{"type":"add","old":null,"new":1028,"text":"\t<h3>Downloads</h3>"},{"type":"add","old":null,"new":1029,"text":"\t<ul>"},{"type":"add","old":null,"new":1030,"text":"\t  <li>Download and install the"},{"type":"add","old":null,"new":1031,"text":"\t  \t<a href=\"http://www.springsource.com/download/community?project=Spring%20Framework\" target=\"_blank\">Spring Framework</a>"},{"type":"add","old":null,"new":1032,"text":"\t  \t(the PetClinic sample application is included)</li>"},{"type":"add","old":null,"new":1033,"text":"\t  <li>Download and install a <a href=\"http://java.sun.com/\" target=\"_blank\">Java</a>"},{"type":"add","old":null,"new":1034,"text":"\t\tSoftware Developer Kit, version 1.5 or later</li>"},{"type":"add","old":null,"new":1035,"text":"\t  <li>Download and install <a href=\"http://maven.apache.org\" target=\"_blank\">Apache Maven</a>,"},{"type":"add","old":null,"new":1036,"text":"\t\tpreferably version 2.0.10 or later</li>"},{"type":"add","old":null,"new":1037,"text":"\t  <li>Download and install <a href=\"http://ant.apache.org\" target=\"_blank\">Apache Ant</a>,"},{"type":"add","old":null,"new":1038,"text":"\t\tpreferably version 1.7.1 or later</li>"},{"type":"add","old":null,"new":1039,"text":"\t  <li>Download and install <a href=\"http://jakarta.apache.org/tomcat/index.html\" target=\"_blank\">Apache Tomcat</a>,"},{"type":"add","old":null,"new":1040,"text":"\t\tpreferably version 6.0.20 or later</li>"},{"type":"add","old":null,"new":1041,"text":"\t  <li>Download and install <a href=\"http://dev.mysql.com/downloads/\" target=\"_blank\">MySQL</a>,"},{"type":"add","old":null,"new":1042,"text":"\t\tpreferably version 5.1.x or later (optional)</li>"},{"type":"add","old":null,"new":1043,"text":"\t  <li><a href=\"http://hsqldb.sourceforge.net/\" target=\"_blank\">Hypersonic SQL</a>, and"},{"type":"add","old":null,"new":1044,"text":"\t  \t<a href=\"http://hibernate.org/\" target=\"_blank\">Hibernate</a> are provided with the"},{"type":"add","old":null,"new":1045,"text":"\t\tapplication.</li>"},{"type":"add","old":null,"new":1046,"text":"\t  <li>PetClinic and Spring use the <a href=\"http://www.apache.org/\" target=\"_blank\">Apache</a>"},{"type":"add","old":null,"new":1047,"text":"\t\t<a href=\"http://commons.apache.org/logging/\" target=\"_blank\">Commons Logging</a>"},{"type":"add","old":null,"new":1048,"text":"\t\tand <a href=\"http://logging.apache.org/log4j/\" target=\"_blank\">log4j</a>"},{"type":"add","old":null,"new":1049,"text":"\t\tpackages.</li>"},{"type":"add","old":null,"new":1050,"text":"\t</ul>"},{"type":"add","old":null,"new":1051,"text":""},{"type":"add","old":null,"new":1052,"text":"\t<h3>Maven Setup</h3>"},{"type":"add","old":null,"new":1053,"text":"\t<p>"},{"type":"add","old":null,"new":1054,"text":"\t\tMake sure that the Maven executable is in your command shell path."},{"type":"add","old":null,"new":1055,"text":"\t</p>"},{"type":"add","old":null,"new":1056,"text":""},{"type":"add","old":null,"new":1057,"text":"\t<h3>MYSQL Setup (optional)</h3>"},{"type":"add","old":null,"new":1058,"text":"\t<p>"},{"type":"add","old":null,"new":1059,"text":"\t\tAdd the PetClinic database to a running MySQL server by following the"},{"type":"add","old":null,"new":1060,"text":"\t\texplicit instructions found in"},{"type":"add","old":null,"new":1061,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">db/mysql/petclinic_db_setup_mysql.txt</span>."},{"type":"add","old":null,"new":1062,"text":"\t\tPetClinic expects by default to be able to access the server via the"},{"type":"add","old":null,"new":1063,"text":"\t\tstandard port <code>3306</code>. To use a different port, it will be"},{"type":"add","old":null,"new":1064,"text":"\t\tnecessary to change the PetClinic Database Setup."},{"type":"add","old":null,"new":1065,"text":"\t</p>"},{"type":"add","old":null,"new":1066,"text":""},{"type":"add","old":null,"new":1067,"text":"\t<h3>PetClinic Database Setup</h3>"},{"type":"add","old":null,"new":1068,"text":"\t<p>"},{"type":"add","old":null,"new":1069,"text":"\t\tTo use a Java EE server supplied connection-pooled data source with"},{"type":"add","old":null,"new":1070,"text":"\t\tTomcat, it will be necessary to use and possibly edit the appropriate"},{"type":"add","old":null,"new":1071,"text":"\t\tcontext definition file for the petclinic webapp. To use it, deploy a"},{"type":"add","old":null,"new":1072,"text":"\t\tcopy of the appropriate context definition file in Tomcat's webapps"},{"type":"add","old":null,"new":1073,"text":"\t\tdirectory and restart the server. Consult the Tomcat log files if"},{"type":"add","old":null,"new":1074,"text":"\t\tsomething goes wrong when starting either Tomcat or the PetClinic"},{"type":"add","old":null,"new":1075,"text":"\t\tapplication. The context files are named"},{"type":"add","old":null,"new":1076,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">petclinic_tomcat_*.xml</span>,"},{"type":"add","old":null,"new":1077,"text":"\t\twhere <strong>*</strong> is either &quot;hsqldb&quot; or &quot;mysql&quot;."},{"type":"add","old":null,"new":1078,"text":"\t\tThere is a context file supplied for each"},{"type":"add","old":null,"new":1079,"text":"\t\tdatabase in its respective directory. There is also a context file"},{"type":"add","old":null,"new":1080,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">db/petclinic_tomcat_all.xml</span>"},{"type":"add","old":null,"new":1081,"text":"\t\tthat will provide a JNDI connection-pooled DataSource for all supported"},{"type":"add","old":null,"new":1082,"text":"\t\tdatabases. Should you use this file, you must of course make sure that all the"},{"type":"add","old":null,"new":1083,"text":"\t\tdatabase servers are running when you restart Tomcat."},{"type":"add","old":null,"new":1084,"text":"\t</p>"},{"type":"add","old":null,"new":1085,"text":""},{"type":"add","old":null,"new":1086,"text":"\t<p>"},{"type":"add","old":null,"new":1087,"text":"\t\t<a name=\"dbNotes\"></a>"},{"type":"add","old":null,"new":1088,"text":"\t\t<span style=\"font-weight: bold;\">NOTES:</span>"}]}],"19.129":[{"path":"src/main/webapp/html/tutorial.html","oldPath":"src/main/webapp/html/tutorial.html","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":1089,"text":"\t</p>"},{"type":"add","old":null,"new":1090,"text":""},{"type":"add","old":null,"new":1091,"text":"\t<ol>"},{"type":"add","old":null,"new":1092,"text":"\t  <li>Should you deploy one of the context files or define a context in"},{"type":"add","old":null,"new":1093,"text":"\t\tTomcat's <span style=\"font-weight: bold; font-style: italic;\">server.xml</span>,"},{"type":"add","old":null,"new":1094,"text":"\t\tTomcat will not automatically deploy the webapp from the"},{"type":"add","old":null,"new":1095,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">petclinic.war</span> file."},{"type":"add","old":null,"new":1096,"text":"\t\tThe webapp will then need to be manually extracted to the target"},{"type":"add","old":null,"new":1097,"text":"\t\tdirectory.</li>"},{"type":"add","old":null,"new":1098,"text":"\t  <li>The context files will also configure logging to supply a"},{"type":"add","old":null,"new":1099,"text":"\t\tseparate log file for the petclinic context. This will separate the"},{"type":"add","old":null,"new":1100,"text":"\t\tcontainer logging for petclinic from that of the other webapps. This"},{"type":"add","old":null,"new":1101,"text":"\t\tshould not be confused with the application log file provided through"},{"type":"add","old":null,"new":1102,"text":"\t\t<span style=\"font-weight: bold;\">log4j.</span></li>"},{"type":"add","old":null,"new":1103,"text":"\t  <li>An Ant script (<span style=\"font-weight: bold; font-style: italic;\">db/build.xml</span>)"},{"type":"add","old":null,"new":1104,"text":"\t\thas been provided that can be used to re-initialize either database. To"},{"type":"add","old":null,"new":1105,"text":"\t\tselect or configure the data source and database used for the webapp and"},{"type":"add","old":null,"new":1106,"text":"\t\tfor testing, you will need to edit the following files:"},{"type":"add","old":null,"new":1107,"text":"\t\t<ul>"},{"type":"add","old":null,"new":1108,"text":"\t\t  <li><span style=\"font-weight: bold; font-style: italic;\">src/main/webapp/WEB-INF/applicationContext-*.xml</span>:"},{"type":"add","old":null,"new":1109,"text":"\t\t\tfor configuring the DataSource in the webapp</li>"},{"type":"add","old":null,"new":1110,"text":"\t\t  <li><span style=\"font-weight: bold; font-style: italic;\">src/main/resources/jdbc.properties</span>:"},{"type":"add","old":null,"new":1111,"text":"\t\t\tfor configuring JDBC connection settings for both the webapp and testing</li>"},{"type":"add","old":null,"new":1112,"text":"\t\t  <li><span style=\"font-weight: bold; font-style: italic;\">build.properties</span>:"},{"type":"add","old":null,"new":1113,"text":"\t\t\tfor running the &quot;tests&quot; target in Ant</li>"},{"type":"add","old":null,"new":1114,"text":"\t\t</ul>"},{"type":"add","old":null,"new":1115,"text":"\t  </li>"},{"type":"add","old":null,"new":1116,"text":"\t</ol>"},{"type":"add","old":null,"new":1117,"text":""},{"type":"add","old":null,"new":1118,"text":"\t<h3>Building the PetClinic Application</h3>"},{"type":"add","old":null,"new":1119,"text":"\t<p>"},{"type":"add","old":null,"new":1120,"text":"\t\tOpen a command line shell and navigate to the directory containing"},{"type":"add","old":null,"new":1121,"text":"\t\tPetClinic. Make sure the database is running and execute"},{"type":"add","old":null,"new":1122,"text":"\t\t&quot;mvn clean package&quot;. This will run clean and compile everything"},{"type":"add","old":null,"new":1123,"text":"\t\tand execute the tests, including integration tests against an in-memory"},{"type":"add","old":null,"new":1124,"text":"\t\tdatabase."},{"type":"add","old":null,"new":1125,"text":"\t</p>"},{"type":"add","old":null,"new":1126,"text":""},{"type":"add","old":null,"new":1127,"text":"\t<h3>Deploying the PetClinic Application</h3>"},{"type":"add","old":null,"new":1128,"text":"\t<p>"},{"type":"add","old":null,"new":1129,"text":"\t\tDeploy the web application to the server in the usual way (see"},{"type":"add","old":null,"new":1130,"text":"\t\t<a href=\"#dbNotes\">notes</a> regarding database setup). If you need"},{"type":"add","old":null,"new":1131,"text":"\t\tinstructions for web application deployment, see the Tomcat"},{"type":"add","old":null,"new":1132,"text":"\t\tdocumentation for details. The Web Application aRchive file is"},{"type":"add","old":null,"new":1133,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">org.springframework.samples.petclinic.war</span>"},{"type":"add","old":null,"new":1134,"text":"\t\tand can be found in the"},{"type":"add","old":null,"new":1135,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">target/artifacts</span> directory."},{"type":"add","old":null,"new":1136,"text":"\t</p>"},{"type":"add","old":null,"new":1137,"text":""},{"type":"add","old":null,"new":1138,"text":"\t<h3>Using the PetClinic Application</h3>"},{"type":"add","old":null,"new":1139,"text":"\t<p>"},{"type":"add","old":null,"new":1140,"text":"\t\tMake sure the PetClinic web application is running and browse to"},{"type":"add","old":null,"new":1141,"text":"\t\t<a href=\"http://localhost:8080/org.springframework.samples.petclinic/\">http://localhost:8080/org.springframework.samples.petclinic/</a>."},{"type":"add","old":null,"new":1142,"text":"\t</p>"},{"type":"add","old":null,"new":1143,"text":""},{"type":"add","old":null,"new":1144,"text":"  <table class=\"footer\">"},{"type":"add","old":null,"new":1145,"text":"    <tr>"},{"type":"add","old":null,"new":1146,"text":"      <td><a href=\"../welcome.do\">Home</a></td>"},{"type":"add","old":null,"new":1147,"text":"      <td align=\"right\"><img src=\"../images/springsource-logo.png\"/></td>"},{"type":"add","old":null,"new":1148,"text":"\t</tr>"},{"type":"add","old":null,"new":1149,"text":"  </table>"},{"type":"add","old":null,"new":1150,"text":"  </div>"},{"type":"add","old":null,"new":1151,"text":"</body>"},{"type":"add","old":null,"new":1152,"text":""},{"type":"add","old":null,"new":1153,"text":"</html>"}]}],"20.1":[{"path":"pom.xml","oldPath":"pom.xml","binary":false,"renameOnly":false,"rows":[{"type":"context","old":3,"new":3,"text":"\txsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd\">"},{"type":"context","old":4,"new":4,"text":"\t<modelVersion>4.0.0</modelVersion>"},{"type":"context","old":5,"new":5,"text":"\t<groupId>org.springframework.samples</groupId>"},{"type":"del","old":6,"new":null,"text":"\t<artifactId>org.springframework.samples.petclinic</artifactId>"},{"type":"add","old":null,"new":6,"text":"\t<artifactId>petclinic-classic</artifactId>"},{"type":"context","old":7,"new":7,"text":"\t<name>petclinic-classic</name>"},{"type":"context","old":8,"new":8,"text":"\t<packaging>war</packaging>"},{"type":"context","old":9,"new":9,"text":"\t<version>1.0.0-SNAPSHOT</version>"},{"type":"context","old":43,"new":43,"text":"\t\t\t<groupId>javax.servlet</groupId>"},{"type":"context","old":44,"new":44,"text":"\t\t\t<artifactId>com.springsource.javax.servlet.jsp.jstl</artifactId>"},{"type":"context","old":45,"new":45,"text":"\t\t\t<version>1.2.0</version>"},{"type":"add","old":null,"new":46,"text":"\t\t\t<scope>provided</scope>"},{"type":"context","old":46,"new":47,"text":"\t\t</dependency>"},{"type":"context","old":47,"new":48,"text":"\t\t<dependency>"},{"type":"context","old":48,"new":49,"text":"\t\t\t<groupId>javax.xml.bind</groupId>"},{"type":"context","old":68,"new":69,"text":"\t\t\t<groupId>org.apache.taglibs</groupId>"},{"type":"context","old":69,"new":70,"text":"\t\t\t<artifactId>com.springsource.org.apache.taglibs.standard</artifactId>"},{"type":"context","old":70,"new":71,"text":"\t\t\t<version>1.1.2</version>"},{"type":"add","old":null,"new":72,"text":"\t\t\t<scope>provided</scope>"},{"type":"context","old":71,"new":73,"text":"\t\t</dependency>\t\t"},{"type":"context","old":72,"new":74,"text":"\t\t<dependency>"},{"type":"context","old":73,"new":75,"text":"\t\t\t<groupId>org.aspectj</groupId>"}]}],"20.2":[{"path":"src/main/resources/hsqldb/dropTables.txt","oldPath":"src/main/webapp/META-INF/hsqldb/dropTables.txt","binary":false,"renameOnly":true,"rows":[]},{"path":"src/main/resources/hsqldb/initDB.txt","oldPath":"src/main/webapp/META-INF/hsqldb/initDB.txt","binary":false,"renameOnly":true,"rows":[]},{"path":"src/main/resources/hsqldb/populateDB.txt","oldPath":"src/main/webapp/META-INF/hsqldb/populateDB.txt","binary":false,"renameOnly":true,"rows":[]}],"20.3":[{"path":"src/main/resources/jdbc.properties","oldPath":"src/main/resources/jdbc.properties","binary":false,"renameOnly":false,"rows":[{"type":"context","old":23,"new":23,"text":""},{"type":"context","old":24,"new":24,"text":"# Properties that control the population of schema and data for a new data source"},{"type":"context","old":25,"new":25,"text":"jdbc.populate=true"},{"type":"del","old":26,"new":null,"text":"jdbc.schemaLocation=classpath:/META-INF/hsqldb/initDB.txt"},{"type":"del","old":27,"new":null,"text":"jdbc.dataLocation=classpath:/META-INF/hsqldb/populateDB.txt"},{"type":"del","old":28,"new":null,"text":"jdbc.dropLocation=classpath:/META-INF/hsqldb/dropTables.txt"},{"type":"add","old":null,"new":26,"text":"jdbc.schemaLocation=classpath:hsqldb/initDB.txt"},{"type":"add","old":null,"new":27,"text":"jdbc.dataLocation=classpath:hsqldb/populateDB.txt"},{"type":"add","old":null,"new":28,"text":"jdbc.dropLocation=classpath:hsqldb/dropTables.txt"},{"type":"context","old":29,"new":29,"text":""},{"type":"context","old":30,"new":30,"text":"# Property that determines which Hibernate dialect to use"},{"type":"context","old":31,"new":31,"text":"# (only applied with \"applicationContext-hibernate.xml\")"}]}]}}