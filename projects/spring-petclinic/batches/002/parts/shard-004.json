text":"automatically download all required dependencies. Thus the initial build"},{"type":"add","old":null,"new":47,"text":"The Spring PetClinic sample application is built using Maven."},{"type":"add","old":null,"new":48,"text":"When the project is first built, Maven will automatically download all required"},{"type":"add","old":null,"new":49,"text":"dependencies (if these haven't been downloaded before). Thus the initial build"},{"type":"context","old":52,"new":50,"text":"may take a few minutes depending on the speed of your Internet connection,"},{"type":"context","old":53,"new":51,"text":"but subsequent builds will be much faster."},{"type":"context","old":54,"new":52,"text":""},{"type":"context","old":55,"new":53,"text":"Available build commands:"},{"type":"context","old":56,"new":54,"text":""},{"type":"del","old":57,"new":null,"text":"- ant clean        --> cleans the project"},{"type":"del","old":58,"new":null,"text":"- ant clean test   --> cleans the project and runs all tests"},{"type":"del","old":59,"new":null,"text":"- ant clean jar    --> cleans the project and builds the WAR"},{"type":"add","old":null,"new":55,"text":"- mvn clean         --> cleans the project"},{"type":"add","old":null,"new":56,"text":"- mvn clean test    --> cleans the project and runs all tests"},{"type":"add","old":null,"new":57,"text":"- mvn clean package --> cleans the project and builds the WAR"},{"type":"context","old":60,"new":58,"text":""},{"type":"del","old":61,"new":null,"text":"After building the project with \"ant clean jar\", you will find the"},{"type":"del","old":62,"new":null,"text":"resulting WAR file in the \"target/artifacts\" directory. By default, an"},{"type":"add","old":null,"new":59,"text":"After building the project with \"mvn clean package\", you will find the"},{"type":"add","old":null,"new":60,"text":"resulting WAR file in the \"target/\" directory. By default, an"},{"type":"context","old":63,"new":61,"text":"embedded HSQLDB instance in configured. No other steps are necessary to"},{"type":"context","old":64,"new":62,"text":"get the data source up and running: you can simply deploy the built WAR"},{"type":"context","old":65,"new":63,"text":"file directly to your Servlet container."}]}],"19.2":[{"path":"src/test/java/org/springframework/samples/petclinic/AbstractClinicTests.java","oldPath":"src/test/java/org/springframework/samples/petclinic/AbstractClinicTests.java","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":1,"text":"package org.springframework.samples.petclinic;"},{"type":"add","old":null,"new":2,"text":""},{"type":"add","old":null,"new":3,"text":"import java.util.Collection;"},{"type":"add","old":null,"new":4,"text":"import java.util.Date;"},{"type":"add","old":null,"new":5,"text":""},{"type":"add","old":null,"new":6,"text":"import static org.junit.Assert.assertEquals;"},{"type":"add","old":null,"new":7,"text":"import static org.junit.Assert.assertTrue;"},{"type":"add","old":null,"new":8,"text":"import org.junit.Test;"},{"type":"add","old":null,"new":9,"text":""},{"type":"add","old":null,"new":10,"text":"import org.springframework.beans.factory.annotation.Autowired;"},{"type":"add","old":null,"new":11,"text":"import org.springframework.samples.petclinic.util.EntityUtils;"},{"type":"add","old":null,"new":12,"text":"import org.springframework.test.context.ContextConfiguration;"},{"type":"add","old":null,"new":13,"text":"import org.springframework.test.context.junit4.AbstractTransactionalJUnit4SpringContextTests;"},{"type":"add","old":null,"new":14,"text":""},{"type":"add","old":null,"new":15,"text":"/**"},{"type":"add","old":null,"new":16,"text":" * <p>"},{"type":"add","old":null,"new":17,"text":" * Base class for {@link Clinic} integration tests."},{"type":"add","old":null,"new":18,"text":" * </p>"},{"type":"add","old":null,"new":19,"text":" * <p>"},{"type":"add","old":null,"new":20,"text":" * &quot;AbstractClinicTests-context.xml&quot; declares a common"},{"type":"add","old":null,"new"