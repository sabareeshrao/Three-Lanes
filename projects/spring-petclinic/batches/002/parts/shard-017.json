ndler methods, applying PetClinic-specific PropertyEditors"},{"type":"add","old":null,"new":30,"text":"\t\t- for request parameter binding. It overrides the default AnnotationMethodHandlerAdapter."},{"type":"add","old":null,"new":31,"text":"\t-->"},{"type":"add","old":null,"new":32,"text":"\t<bean class=\"org.springframework.web.servlet.mvc.annotation.AnnotationMethodHandlerAdapter\">"},{"type":"add","old":null,"new":33,"text":"\t\t<property name=\"webBindingInitializer\">"},{"type":"add","old":null,"new":34,"text":"\t\t\t<bean class=\"org.springframework.samples.petclinic.web.ClinicBindingInitializer\"/>"},{"type":"add","old":null,"new":35,"text":"\t\t</property>"},{"type":"add","old":null,"new":36,"text":"\t</bean>"},{"type":"add","old":null,"new":37,"text":""},{"type":"add","old":null,"new":38,"text":"\t<!--"},{"type":"add","old":null,"new":39,"text":"\t\t- This bean resolves specific types of exceptions to corresponding logical "},{"type":"add","old":null,"new":40,"text":"\t\t- view names for error views. The default behaviour of DispatcherServlet "},{"type":"add","old":null,"new":41,"text":"\t\t- is to propagate all exceptions to the servlet container: this will happen "},{"type":"add","old":null,"new":42,"text":"\t\t- here with all other types of exceptions."},{"type":"add","old":null,"new":43,"text":"\t-->"},{"type":"add","old":null,"new":44,"text":"\t<bean class=\"org.springframework.web.servlet.handler.SimpleMappingExceptionResolver\">"},{"type":"add","old":null,"new":45,"text":"\t\t<property name=\"exceptionMappings\">"},{"type":"add","old":null,"new":46,"text":"\t\t\t<props>"},{"type":"add","old":null,"new":47,"text":"\t\t\t\t<prop key=\"org.springframework.web.servlet.PageNotFound\">pageNotFound</prop>"},{"type":"add","old":null,"new":48,"text":"\t\t\t\t<prop key=\"org.springframework.dao.DataAccessException\">dataAccessFailure</prop>"},{"type":"add","old":null,"new":49,"text":"\t\t\t\t<prop key=\"org.springframework.transaction.TransactionException\">dataAccessFailure</prop>"},{"type":"add","old":null,"new":50,"text":"\t\t\t</props>"},{"type":"add","old":null,"new":51,"text":"\t\t</property>"},{"type":"add","old":null,"new":52,"text":"\t</bean>"},{"type":"add","old":null,"new":53,"text":""},{"type":"add","old":null,"new":54,"text":"\t<!--"},{"type":"add","old":null,"new":55,"text":"\t\t- This view resolver delegates to the InternalResourceViewResolver and BeanNameViewResolver,"},{"type":"add","old":null,"new":56,"text":"\t\t- and uses the requested media type to pick a matching view. When the media type is 'text/html',"},{"type":"add","old":null,"new":57,"text":"\t\t- it will delegate to the InternalResourceViewResolver's JstlView, otherwise to the"},{"type":"add","old":null,"new":58,"text":"\t\t- BeanNameViewResolver. Note the use of the expression language to refer to the contentType"},{"type":"add","old":null,"new":59,"text":"\t\t- property of the vets view bean, setting it to 'application/vnd.springsource.samples.petclinic+xml'."},{"type":"add","old":null,"new":60,"text":"\t-->"},{"type":"add","old":null,"new":61,"text":"\t<bean class=\"org.springframework.web.servlet.view.ContentNegotiatingViewResolver\">"},{"type":"add","old":null,"new":62,"text":"\t\t<property name=\"mediaTypes\">"},{"type":"add","old":null,"new":63,"text":"\t\t\t<map>"},{"type":"add","old":null,"new":64,"text":"\t\t\t\t<entry key=\"xml\" value=\"#{vets.contentType}\"/>"},{"type":"add","old":null,"new":65,"text":"\t\t\t\t<entry key=\"atom\" value=\"#{visits.contentType}\"/>"},{"type":"add","old":null,"new":66,"text":"\t\t\t</map>"},{"type":"add","old":null,"new":67,"text":"\t\t</property>"},{"type":"add","old":null,"new":68,"text":"\t\t<property name=\"order\" value=\"0\"/>"}]}],"19.108":[{"path":"src/main/webapp/WEB-INF/petclinic-servlet.xml","oldPath":"src/main/webapp/WEB-INF/petclinic-servlet.xml","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":69,"text":"\t</bean>"},{"type":"add","old":null,"new":70,"text":"\t"}