ll,"new":13,"text":"\t\t\thttp://www.springframework.org/schema/jee http://www.springframework.org/schema/jee/spring-jee-2.5.xsd"},{"type":"add","old":null,"new":14,"text":"\t\t\thttp://www.springframework.org/schema/tx http://www.springframework.org/schema/tx/spring-tx-2.5.xsd\">"},{"type":"add","old":null,"new":15,"text":""},{"type":"add","old":null,"new":16,"text":"\t<!-- ========================= RESOURCE DEFINITIONS ========================= -->"},{"type":"add","old":null,"new":17,"text":""},{"type":"add","old":null,"new":18,"text":"\t<!-- Configurer that replaces ${...} placeholders with values from a properties file -->"},{"type":"add","old":null,"new":19,"text":"\t<!-- (in this case, JDBC-related settings for the dataSource definition below) -->"},{"type":"add","old":null,"new":20,"text":"\t<context:property-placeholder location=\"classpath:jdbc.properties\"/>"},{"type":"add","old":null,"new":21,"text":""},{"type":"add","old":null,"new":22,"text":"\t<!--"},{"type":"add","old":null,"new":23,"text":"\t\tSpring FactoryBean that creates a DataSource using Apache Commons DBCP for connection "},{"type":"add","old":null,"new":24,"text":"\t\tpooling. See Commons DBCP documentation for the required JAR files.  This factory bean"},{"type":"add","old":null,"new":25,"text":"\t\tcan populate the data source with a schema and data scripts if configured to do so."},{"type":"add","old":null,"new":26,"text":"\t\t"},{"type":"add","old":null,"new":27,"text":"\t\tAn alternate factory bean can be created for different connection pool implementations,"},{"type":"add","old":null,"new":28,"text":"\t\tC3P0 for example."},{"type":"add","old":null,"new":29,"text":"\t-->"},{"type":"add","old":null,"new":30,"text":"\t<bean id=\"dataSource\" class=\"org.springframework.samples.petclinic.config.DbcpDataSourceFactory\""},{"type":"add","old":null,"new":31,"text":"\t\t\tp:driverClassName=\"${jdbc.driverClassName}\" p:url=\"${jdbc.url}\" "},{"type":"add","old":null,"new":32,"text":"\t\t\tp:username=\"${jdbc.username}\" p:password=\"${jdbc.password}\" p:populate=\"${jdbc.populate}\""},{"type":"add","old":null,"new":33,"text":"\t\t\tp:schemaLocation=\"${jdbc.schemaLocation}\" p:dataLocation=\"${jdbc.dataLocation}\"/>"},{"type":"add","old":null,"new":34,"text":""},{"type":"add","old":null,"new":35,"text":"\t<!-- JNDI DataSource for JEE environments -->"},{"type":"add","old":null,"new":36,"text":"\t<!--"},{"type":"add","old":null,"new":37,"text":"\t<jee:jndi-lookup id=\"dataSource\" jndi-name=\"java:comp/env/jdbc/petclinic\"/>"},{"type":"add","old":null,"new":38,"text":"\t-->"},{"type":"add","old":null,"new":39,"text":""},{"type":"add","old":null,"new":40,"text":"\t<!-- Transaction manager for a single JDBC DataSource (alternative to JTA) -->"},{"type":"add","old":null,"new":41,"text":"\t<bean id=\"transactionManager\" class=\"org.springframework.jdbc.datasource.DataSourceTransactionManager\""},{"type":"add","old":null,"new":42,"text":"\t\t\tp:dataSource-ref=\"dataSource\"/>"},{"type":"add","old":null,"new":43,"text":""},{"type":"add","old":null,"new":44,"text":"\t<!-- Transaction manager that delegates to JTA (for a transactional JNDI DataSource) -->"},{"type":"add","old":null,"new":45,"text":"\t<!--"},{"type":"add","old":null,"new":46,"text":"\t<bean id=\"transactionManager\" class=\"org.springframework.transaction.jta.JtaTransactionManager\"/>"},{"type":"add","old":null,"new":47,"text":"\t-->"},{"type":"add","old":null,"new":48,"text":""},{"type":"add","old":null,"new":49,"text":""},{"type":"add","old":null,"new":50,"text":"\t<!-- ========================= BUSINESS OBJECT DEFINITIONS ========================= -->"},{"type":"add","old":null,"new":51,"text":""},{"type":"add","old":null,"new":52,"text":"\t<!--"},{"type":"add","old":null,"new":53,"text":"\t\tActivates various annotations to be detected in bean classes: Spring's"},{"type":"add","old":null,"new":54,"text":"\t\t@Required and @Autowired, as well as JSR 250's @PostConstruct,"},{"type":"add","old"