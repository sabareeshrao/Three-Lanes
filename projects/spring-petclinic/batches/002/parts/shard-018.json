{"steps":{"19.109":[{"path":"src/main/webapp/WEB-INF/web.xml","oldPath":"src/main/webapp/WEB-INF/web.xml","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":1,"text":"<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?>"},{"type":"add","old":null,"new":2,"text":"<web-app version=\"2.4\" xmlns=\"http://java.sun.com/xml/ns/j2ee\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\""},{"type":"add","old":null,"new":3,"text":"\t\txsi:schemaLocation=\"http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd\">"},{"type":"add","old":null,"new":4,"text":""},{"type":"add","old":null,"new":5,"text":"\t<display-name>Spring PetClinic</display-name>"},{"type":"add","old":null,"new":6,"text":""},{"type":"add","old":null,"new":7,"text":"\t<description>Spring PetClinic sample application</description>"},{"type":"add","old":null,"new":8,"text":""},{"type":"add","old":null,"new":9,"text":"\t<!--"},{"type":"add","old":null,"new":10,"text":"\t\tKey of the system property that should specify the root directory of this"},{"type":"add","old":null,"new":11,"text":"\t\tweb app. Applied by WebAppRootListener or Log4jConfigListener."},{"type":"add","old":null,"new":12,"text":"\t-->"},{"type":"add","old":null,"new":13,"text":"\t<context-param>"},{"type":"add","old":null,"new":14,"text":"\t\t<param-name>webAppRootKey</param-name>"},{"type":"add","old":null,"new":15,"text":"\t\t<param-value>petclinic.root</param-value>"},{"type":"add","old":null,"new":16,"text":"\t</context-param>"},{"type":"add","old":null,"new":17,"text":"\t"},{"type":"add","old":null,"new":18,"text":"\t"},{"type":"add","old":null,"new":19,"text":""},{"type":"add","old":null,"new":20,"text":"\t<!--"},{"type":"add","old":null,"new":21,"text":"\t\tLocation of the Log4J config file, for initialization and refresh checks."},{"type":"add","old":null,"new":22,"text":"\t\tApplied by Log4jConfigListener."},{"type":"add","old":null,"new":23,"text":"\t-->"},{"type":"add","old":null,"new":24,"text":"\t<context-param>"},{"type":"add","old":null,"new":25,"text":"\t\t<param-name>log4jConfigLocation</param-name>"},{"type":"add","old":null,"new":26,"text":"\t\t<param-value>/WEB-INF/classes/log4j.properties</param-value>"},{"type":"add","old":null,"new":27,"text":"\t</context-param>"},{"type":"add","old":null,"new":28,"text":""},{"type":"add","old":null,"new":29,"text":"\t<!--"},{"type":"add","old":null,"new":30,"text":"\t\t- Location of the XML file that defines the root application context."},{"type":"add","old":null,"new":31,"text":"\t\t- Applied by ContextLoaderServlet."},{"type":"add","old":null,"new":32,"text":"\t\t-"},{"type":"add","old":null,"new":33,"text":"\t\t- Can be set to:"},{"type":"add","old":null,"new":34,"text":"\t\t- \"/WEB-INF/applicationContext-hibernate.xml\" for the Hibernate implementation,"},{"type":"add","old":null,"new":35,"text":"\t\t- \"/WEB-INF/applicationContext-jpa.xml\" for the JPA one, or"},{"type":"add","old":null,"new":36,"text":"\t\t- \"/WEB-INF/applicationContext-jdbc.xml\" for the JDBC one."},{"type":"add","old":null,"new":37,"text":"\t-->"},{"type":"add","old":null,"new":38,"text":"\t<context-param>"},{"type":"add","old":null,"new":39,"text":"\t\t<param-name>contextConfigLocation</param-name>"},{"type":"add","old":null,"new":40,"text":""},{"type":"add","old":null,"new":41,"text":"\t\t<param-value>/WEB-INF/applicationContext-jdbc.xml</param-value>"},{"type":"add","old":null,"new":42,"text":"\t\t<!--"},{"type":"add","old":null,"new":43,"text":"\t\t<param-value>/WEB-INF/applicationContext-hibernate.xml</param-value>"},{"type":"add","old":null,"new":44,"text":"\t\t<param-value>/WEB-INF/applicationContext-jpa.xml</param-value>"},{"type":"add","old":null,"new":45,"text":"\t\t-->"},{"type":"add","old":null,"new":46,"text":""},{"type":"add","old":null,"new":47,"text":"\t\t<!--"},{"type":"add","old":null,"new":48,"text":"\t\t\tTo use the JPA variant above, you will need to enable Spring load-time"},{"type":"add","old":null,"new":49,"text":"\t\t\tweaving in your server environment. See PetClinic's readme and/or"},{"type":"add","old":null,"new":50,"text":"\t\t\tSpring's JPA documentation for information on how to do this."},{"type":"add","old":null,"new":51,"text":"\t\t-->"},{"type":"add","old":null,"new":52,"text":"\t</context-param>"},{"type":"add","old":null,"new":53,"text":""},{"type":"add","old":null,"new":54,"text":"\t<!--"},{"type":"add","old":null,"new":55,"text":"\t\t- Configures Log4J for this web app."},{"type":"add","old":null,"new":56,"text":"\t\t- As this context specifies a context-param \"log4jConfigLocation\", its file path"},{"type":"add","old":null,"new":57,"text":"\t\t- is used to load the Log4J configuration, including periodic refresh checks."},{"type":"add","old":null,"new":58,"text":"\t\t-"},{"type":"add","old":null,"new":59,"text":"\t\t- Would fall back to default Log4J initialization (non-refreshing) if no special"},{"type":"add","old":null,"new":60,"text":"\t\t- context-params are given."},{"type":"add","old":null,"new":61,"text":"\t\t-"},{"type":"add","old":null,"new":62,"text":"\t\t- Exports a \"web app root key\", i.e. a system property that specifies the root"},{"type":"add","old":null,"new":63,"text":"\t\t- directory of this web app, for usage in log file paths."},{"type":"add","old":null,"new":64,"text":"\t\t- This web app specifies \"petclinic.root\" (see log4j.properties file)."},{"type":"add","old":null,"new":65,"text":"\t-->"},{"type":"add","old":null,"new":66,"text":"\t<!-- Leave the listener commented-out if using JBoss -->"},{"type":"add","old":null,"new":67,"text":"\t<!--"},{"type":"add","old":null,"new":68,"text":"\t<listener>"}]}],"19.110":[{"path":"src/main/webapp/WEB-INF/web.xml","oldPath":"src/main/webapp/WEB-INF/web.xml","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":69,"text":"\t\t<listener-class>org.springframework.web.util.Log4jConfigListener</listener-class>"},{"type":"add","old":null,"new":70,"text":"\t</listener>"},{"type":"add","old":null,"new":71,"text":"\t-->"},{"type":"add","old":null,"new":72,"text":""},{"type":"add","old":null,"new":73,"text":"\t<!--"},{"type":"add","old":null,"new":74,"text":"\t\t- Loads the root application context of this web app at startup,"},{"type":"add","old":null,"new":75,"text":"\t\t- by default from \"/WEB-INF/applicationContext.xml\"."},{"type":"add","old":null,"new":76,"text":"\t\t- Note that you need to fall back to Spring's ContextLoaderServlet for"},{"type":"add","old":null,"new":77,"text":"\t\t- J2EE servers that do not follow the Servlet 2.4 initialization order."},{"type":"add","old":null,"new":78,"text":"\t\t-"},{"type":"add","old":null,"new":79,"text":"\t\t- Use WebApplicationContextUtils.getWebApplicationContext(servletContext)"},{"type":"add","old":null,"new":80,"text":"\t\t- to access it anywhere in the web application, outside of the framework."},{"type":"add","old":null,"new":81,"text":"\t\t-"},{"type":"add","old":null,"new":82,"text":"\t\t- The root context is the parent of all servlet-specific contexts."},{"type":"add","old":null,"new":83,"text":"\t\t- This means that its beans are automatically available in these child contexts,"},{"type":"add","old":null,"new":84,"text":"\t\t- both for getBean(name) calls and (external) bean references."},{"type":"add","old":null,"new":85,"text":"\t-->"},{"type":"add","old":null,"new":86,"text":"\t<listener>"},{"type":"add","old":null,"new":87,"text":"\t\t<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>"},{"type":"add","old":null,"new":88,"text":"\t</listener>"},{"type":"add","old":null,"new":89,"text":"\t"},{"type":"add","old":null,"new":90,"text":"\t<!--"},{"type":"add","old":null,"new":91,"text":"\t - Map static resources to the default servlet"},{"type":"add","old":null,"new":92,"text":"\t - examples:"},{"type":"add","old":null,"new":93,"text":"\t -     http://localhost:8080/static/images/pets.png"},{"type":"add","old":null,"new":94,"text":"\t -     http://localhost:8080/static/styles/petclinic.css"},{"type":"add","old":null,"new":95,"text":"\t-->"},{"type":"add","old":null,"new":96,"text":"\t<servlet-mapping>"},{"type":"add","old":null,"new":97,"text":"\t\t<servlet-name>default</servlet-name>"},{"type":"add","old":null,"new":98,"text":"\t\t<url-pattern>/static/*</url-pattern>"},{"type":"add","old":null,"new":99,"text":"\t</servlet-mapping>"},{"type":"add","old":null,"new":100,"text":"\t"},{"type":"add","old":null,"new":101,"text":"\t<!--"},{"type":"add","old":null,"new":102,"text":"\t\t- Servlet that dispatches request to registered handlers (Controller implementations)."},{"type":"add","old":null,"new":103,"text":"\t\t- Has its own application context, by default defined in \"{servlet-name}-servlet.xml\","},{"type":"add","old":null,"new":104,"text":"\t\t- i.e. \"petclinic-servlet.xml\"."},{"type":"add","old":null,"new":105,"text":"\t\t-"},{"type":"add","old":null,"new":106,"text":"\t\t- A web app can contain any number of such servlets."},{"type":"add","old":null,"new":107,"text":"\t\t- Note that this web app has a shared root application context, serving as parent"},{"type":"add","old":null,"new":108,"text":"\t\t- of all DispatcherServlet contexts."},{"type":"add","old":null,"new":109,"text":"\t-->"},{"type":"add","old":null,"new":110,"text":"\t<servlet>"},{"type":"add","old":null,"new":111,"text":"\t\t<servlet-name>petclinic</servlet-name>"},{"type":"add","old":null,"new":112,"text":"\t\t<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>"},{"type":"add","old":null,"new":113,"text":"\t\t<load-on-startup>2</load-on-startup>"},{"type":"add","old":null,"new":114,"text":"\t</servlet>"},{"type":"add","old":null,"new":115,"text":""},{"type":"add","old":null,"new":116,"text":"\t<!--"},{"type":"add","old":null,"new":117,"text":"\t\t- Maps the petclinic dispatcher to \"*.do\". All handler mappings in"},{"type":"add","old":null,"new":118,"text":"\t\t- petclinic-servlet.xml will by default be applied to this subpath."},{"type":"add","old":null,"new":119,"text":"\t\t- If a mapping isn't a /* subpath, the handler mappings are considered"},{"type":"add","old":null,"new":120,"text":"\t\t- relative to the web app root."},{"type":"add","old":null,"new":121,"text":"\t\t-"},{"type":"add","old":null,"new":122,"text":"\t\t- NOTE: A single dispatcher can be mapped to multiple paths, like any servlet."},{"type":"add","old":null,"new":123,"text":"\t-->"},{"type":"add","old":null,"new":124,"text":"\t<servlet-mapping>"},{"type":"add","old":null,"new":125,"text":"\t\t<servlet-name>petclinic</servlet-name>"},{"type":"add","old":null,"new":126,"text":"\t\t<url-pattern>/</url-pattern>"},{"type":"add","old":null,"new":127,"text":"\t</servlet-mapping>"},{"type":"add","old":null,"new":128,"text":""},{"type":"add","old":null,"new":129,"text":"    <filter>"},{"type":"add","old":null,"new":130,"text":"        <filter-name>httpMethodFilter</filter-name>"},{"type":"add","old":null,"new":131,"text":"        <filter-class>org.springframework.web.filter.HiddenHttpMethodFilter</filter-class>"},{"type":"add","old":null,"new":132,"text":"    </filter>"},{"type":"add","old":null,"new":133,"text":""},{"type":"add","old":null,"new":134,"text":"    <filter-mapping>"},{"type":"add","old":null,"new":135,"text":"        <filter-name>httpMethodFilter</filter-name>"},{"type":"add","old":null,"new":136,"text":"        <servlet-name>petclinic</servlet-name>"}]}],"19.111":[{"path":"src/main/webapp/WEB-INF/web.xml","oldPath":"src/main/webapp/WEB-INF/web.xml","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":137,"text":"    </filter-mapping>"},{"type":"add","old":null,"new":138,"text":"    "},{"type":"add","old":null,"new":139,"text":"\t<session-config>"},{"type":"add","old":null,"new":140,"text":"\t\t<session-timeout>10</session-timeout>"},{"type":"add","old":null,"new":141,"text":"\t</session-config>"},{"type":"add","old":null,"new":142,"text":""},{"type":"add","old":null,