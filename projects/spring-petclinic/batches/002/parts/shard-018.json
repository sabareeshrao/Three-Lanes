"old":null,"new":2,"text":"<html>"},{"type":"add","old":null,"new":3,"text":"<head>"},{"type":"add","old":null,"new":4,"text":"\t<title>The Spring PetClinic Application</title>"},{"type":"add","old":null,"new":5,"text":"\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=ISO-8859-1\">"},{"type":"add","old":null,"new":6,"text":"\t<link rel=\"stylesheet\" href=\"../styles/petclinic.css\" type=\"text/css\">"},{"type":"add","old":null,"new":7,"text":"</head>"},{"type":"add","old":null,"new":8,"text":""},{"type":"add","old":null,"new":9,"text":"<body>"},{"type":"add","old":null,"new":10,"text":""},{"type":"add","old":null,"new":11,"text":"<div id=\"main\">"},{"type":"add","old":null,"new":12,"text":""},{"type":"add","old":null,"new":13,"text":"\t<h1>The Spring PetClinic Application</h1>"},{"type":"add","old":null,"new":14,"text":""},{"type":"add","old":null,"new":15,"text":"   <!--"},{"type":"add","old":null,"new":16,"text":"   <table class=\"updated\">"},{"type":"add","old":null,"new":17,"text":"   <tr><td>Updated:</td><td>25.NOV.2009</td><td>Costin Leau(<strong>Work In Progress: not yet fully updated regarding Spring 3.0</strong>)</td></tr>"},{"type":"add","old":null,"new":18,"text":"\t<tr><td></td><td>11.OCT.2009</td><td>Sam Brannen</td></tr>"},{"type":"add","old":null,"new":19,"text":"\t<tr><td></td><td>21.OCT.2007</td><td>Sam Brannen</td></tr>"},{"type":"add","old":null,"new":20,"text":"\t<tr><td></td><td>30.JUN.2006</td><td>Costin Leau</td></tr>"},{"type":"add","old":null,"new":21,"text":"\t<tr><td></td><td>01.DEC.2004</td><td>Ken Krebs</td></tr>"},{"type":"add","old":null,"new":22,"text":"\t<tr><td></td><td>16.AUG.2003</td><td>Ken Krebs</td></tr>"},{"type":"add","old":null,"new":23,"text":"\t</table>"},{"type":"add","old":null,"new":24,"text":"    -->"},{"type":"add","old":null,"new":25,"text":""},{"type":"add","old":null,"new":26,"text":"<!-- === INTRODUCTION ====================================================== -->"},{"type":"add","old":null,"new":27,"text":"\t<h2>Introduction</h2>"},{"type":"add","old":null,"new":28,"text":""},{"type":"add","old":null,"new":29,"text":"\t<p>"},{"type":"add","old":null,"new":30,"text":"\t\tThe Spring Framework is a collection of small, well-focused, loosely coupled Java"},{"type":"add","old":null,"new":31,"text":"\t\tframeworks that can be used independently or collectively to build"},{"type":"add","old":null,"new":32,"text":"\t\tindustrial strength applications of many different types. The PetClinic"},{"type":"add","old":null,"new":33,"text":"\t\tsample application is designed to show how the Spring"},{"type":"add","old":null,"new":34,"text":"\t\tapplication frameworks can be used to build simple, but powerful"},{"type":"add","old":null,"new":35,"text":"\t\tdatabase-oriented applications. It will demonstrate the use"},{"type":"add","old":null,"new":36,"text":"\t\tof Spring's core functionality:"},{"type":"add","old":null,"new":37,"text":"\t</p>"},{"type":"add","old":null,"new":38,"text":""},{"type":"add","old":null,"new":39,"text":"\t<ul>"},{"type":"add","old":null,"new":40,"text":"\t  <li>JavaBeans based application configuration using Inversion-Of-Control</li>"},{"type":"add","old":null,"new":41,"text":"\t  <li>Model-View-Controller web Presentation Layer</li>"},{"type":"add","old":null,"new":42,"text":"\t  <li>Practical database access through JDBC, Hibernate, or Java Persistence API</li>"},{"type":"add","old":null,"new":43,"text":"\t  <li>Application monitoring based on JMX</li>"},{"type":"add","old":null,"new":44,"text":"\t  <li>Declarative Transaction Management using AOP</li>"},{"type":"add","old":null,"new":45,"text":"\t  <li>Data Validation that supports but is not dependent on the Presentation Layer</li>"},{"type":"add","old":null,"new":46,"text":"\t</ul>"},{"type":"add","old":null,"new":47,"text":""},{"type":"add","old":null,"new":48,"text":"\t<p>"},{"type":"add","old":null,"new":49,"text":"\t\tThe Spring frameworks provide a great deal of useful infrastructure to"},{"type":"add","old":null,"new":50,"text":"\t\tsimplify the tasks faced by application developers. This infrastructure"},{"type":"add","old":null,"new":51,"text":"\t\thelps developers to create applications that are:"},{"type":"add","old":null,"new":52,"text":"\t</p>"},{"type":"add","old":null,"new":53,"text":""},{"type":"add","old":null,"new":54,"text":"\t<ul>"},{"type":"add","old":null,"new":55,"text":"\t  <li>"},{"type":"add","old":null,"new":56,"text":"\t  \t<span style=\"font-weight: bold; text-decoration: underline;\">concise</span>"},{"type":"add","old":null,"new":57,"text":"\t\tby handling a lot of the complex control flow that is needed to use the"},{"type":"add","old":null,"new":58,"text":"\t\tJava API's, such as JDBC, JNDI, JTA, RMI, and EJB."},{"type":"add","old":null,"new":59,"text":"\t  </li>"},{"type":"add","old":null,"new":60,"text":"\t  <li>"},{"type":"add","old":null,"new":61,"text":"\t  \t<span style=\"font-weight: bold; text-decoration: underline;\">flexible</span>"},{"type":"add","old":null,"new":62,"text":"\t\tby simplifying the process of external application configuration"},{"type":"add","old":null,"new":63,"text":"\t\tthrough the use of Reflection and JavaBeans. This allows the developer to"},{"type":"add","old":null,"new":64,"text":"\t\tachieve a clean separation of configuration data from application code."},{"type":"add","old":null,"new":65,"text":"\t\tAll application and web application objects, including validators,"},{"type":"add","old":null,"new":66,"text":"\t\tworkflow controllers, and views, are JavaBeans that can be configured"},{"type":"add","old":null,"new":67,"text":"\t\texternally.</li>"},{"type":"add","old":null,"new":68,"text":"\t  <li>"}]}],"19.114":[{"path":"src/main/webapp/html/tutorial.html","oldPath":"src/main/webapp/html/tutorial.html","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":69,"text":"\t  \t<span style=\"font-weight: bold; text-decoration: underline;\">testable</span>"},{"type":"add","old":null,"new":70,"text":"\t\tby supplying an interface based design to maximize pluggability. This"},{"type":"add","old":null,"new":71,"text":"\t\tfacilitates unit testing of Business Logic without requiring the"},{"type":"add","old":null,"new":72,"text":"\t\tpresence of application or live database servers.</li>"},{"type":"add","old":null,"new":73,"text":"\t  <li>"},{"type":"add","old":null,"new":74,"text":"\t  \t<span style=\"font-weight: bold; text-decoration: underline;\">maintainable</span>"},{"type":"add","old":null,"new":75,"text":"\t\tby facilitating a clean separation of the application layers. It most"},{"type":"add","old":null,"new":76,"text":"\t\timportantly helps maintain the independence of the Business Layer"},{"type":"add","old":null,"new":77,"text":"\t\tfrom the Presentation layer. PetClinic demonstrates the use of a"},{"type":"add","old":null,"new":78,"text":"\t\tModel-View-Controller"},{"type":"add","old":null,"new":79,"text":"\t\tbased web presentation framework that can work seamlessly with many"},{"type":"add","old":null,"new":80,"text":"\t\tdifferent types of view technologies. The Spring web application"},{"type":"add","old":null,"new":81,"text":"\t\tframework helps developers to implement their Presentation as a clean"},{"type":"add","old":null,"new":82,"text":"\t\tand thin layer focused on its main missions of translating user actions"},{"type":"add","old":null,"new":83,"text":"\t\tinto application events and rendering model data.</li>"},{"type":"add","old":null,"new":84,"text":"\t</ul>"},{"type":"add","old":null,"new":85,"text":""},{"type":"add","old":null,"new":86,"text":"\t<p>"},{"type":"add","old":null,"new":87,"text":"\t\tIt is assumed that users of this tutorial will have a basic knowledge"},{"type":"add","old":null,"new":88,"text":"\t\tof object-oriented design, Java, Servlets, JSP, and relational"},{"type":"add","old":null,"new":89,"text":"\t\tdatabases. It also assumes a basic knowledge of the use of a Java EE web"},{"type":"add","old":null,"new":90,"text":"\t\tapplication container."},{"type":"add","old":null,"new":91,"text":"\t</p>"},{"type":"add","old":null,"new":92,"text":""},{"type":"add","old":null,"new":93,"text":"\t<p>"},{"type":"add","old":null,"new":94,"text":"\t\tSince the purpose of the sample application is tutorial in nature, the"},{"type":"add","old":null,"new":95,"text":"\t\timplementation presented here will of course provide only a small"},{"type":"add","old":null,"new":96,"text":"\t\tsubset of the functionality that would be needed by a real world version of a"},{"type":"add","old":null,"new":97,"text":"\t\tPetClinic application."},{"type":"add","old":null,"new":98,"text":"\t</p>"},{"type":"add","old":null,"new":99,"text":""},{"type":"add","old":null,"new":100,"text":"<!-- === REQUIREMENTS ====================================================== -->"},{"type":"add","old":null,"new":101,"text":"\t<h2>PetClinic Sample Application Requirements</h2>"},{"type":"add","old":null,"new":102,"text":""},{"type":"add","old":null,"new":103,"text":"\t<p>"},{"type":"add","old":null,"new":104,"text":"\t\tThe application requirement is for an information system that is"},{"type":"add","old":null,"new":105,"text":"\t\taccessible through a web browser. The users of the application are"},{"type":"add","old":null,"new":106,"text":"\t\temployees of the clinic who in the course of their work need to view"},{"type":"add","old":null,"new":107,"text":"\t\tand manage information regarding the veterinarians, the clients, and their"},{"type":"add","old":null,"new":108,"text":"\t\tpets. The sample application supports the following:"},{"type":"add","old":null,"new":109,"text":"\t</p>"},{"type":"add","old":null,"new":110,"text":""},{"type":"add","old":null,"new":111,"text":"\t<h3>Use Cases</h3>"},{"type":"add","old":null,"new":112,"text":"\t<ul>"},{"type":"add","old":null,"new":113,"text":"\t  <li>View a list of veterinarians and their specialties</li>"},{"type":"add","old":null,"new":114,"text":"\t  <li>View information pertaining to a pet owner</li>"},{"type":"add","old":null,"new":115,"text":"\t  <li>Update the information pertaining to a pet owner</li>"},{"type":"add","old":null,"new":116,"text":"\t  <li>Add a new pet owner to the system</li>"},{"type":"add","old":null,"new":117,"text":"\t  <li>View information pertaining to a pet</li>"},{"type":"add","old":null,"new":118,"text":"\t  <li>Update the information pertaining to a pet</li>"},{"type":"add","old":null,"new":119,"text":"\t  <li>Add a new pet to the system</li>"},{"type":"add","old":null,"new":120,"text":"\t  <li>View information pertaining to a pet's visitation history</li>"},{"type":"add","old":null,"new":121,"text":"\t  <li>Add information pertaining to a visit to the pet's visitation history</li>"},{"type":"add","old":null,"new":122,"text":"\t</ul>"},{"type":"add","old":null,"new":123,"text":""},{"type":"add","old":null,"new":124,"text":"\t<h3>Business Rules</h3>"},{"type":"add","old":null,"new":125,"text":"\t<ol>"},{"type":"add","old":null,"new":126,"text":"\t  <li>An owner may not have multiple pets with the same case-insensitive name.</li>"},{"type":"add","old":null,"new":127,"text":"\t</ol>"},{"type":"add","old":null,"new":128,"text":""},{"type":"add","old":null,"new":129,"text":"<!-- === DESIGN AND IMPLEMENTATION ========================================= -->"},{"type":"add","old":null,"new":130,"text":"\t<h2>PetClinic Sample Application Design &amp; Implementation</h2>"},{"type":"add","old":null,"new":131,"text":""},{"type":"add","old":null,"new":132,"text":"\t<h3>Server Technology</h3>"},{"type":"add","old":null,"new":133,"text":"\t<p>"},{"type":"add","old":null,"new":134,"text":"\t\tThe sample application should be usable with any Java EE web application"},{"type":"add","old":null,"new":135,"text":"\t\tcontainer that is compatible with the Servlet 2.4 and JSP 2.0"},{"type":"add","old":null,"new":136,"text":"\t\tspecifications. Some of the deployment files provided are designed"}]}],"19.115":[{"path":"src/main/webapp/html/tutorial.html","oldPath":"src/main/webapp/html/tutorial.html","binary":false,"renameOnly":false,"rows":[{"type":"add","old":null,"new":137,"text":"\t\tspecifically for Apache Tomcat. These files specify container-supplied"},{"type":"add","old":null,"new":138,"text":"\t\tconnection-pooled data sources. It is not necessary to use these files."},{"type":"add","old":null,"new":139,"text":"\t\tThe application has been configured by default to use a data source"},{"type":"add","old":null,"new":140,"text":"\t\twith connection pooling. Configuration details are"},{"type":"add","old":null,"new":141,"text":"\t\tprovided in the Developer Instructions section. The view technologies"},{"type":"add","old":null,"new":142,"text":"\t\tthat are to be used for rendering the application are Java Server Pages"},{"type":"add","old":null,"new":143,"text":"\t\t(JSP) along with the Java Standard Tag Library (JSTL)."},{"type":"add","old":null,"new":144,"text":"\t</p>"},{"type":"add","old":null,"new":145,"text":""},{"type":"add","old":null,"new":146,"text":"\t<h3>Database Technology</h3>"},{"type":"add","old":null,"new":147,"text":"\t<p>"},{"type":"add","old":null,"new":148,"text":"\t\tThe sample application uses a relational database for data storage."},{"type":"add","old":null,"new":149,"text":"\t\tSupport has been provided for a choice of 1 of 2 database selections,"},{"type":"add","old":null,"new":150,"text":"\t\tMySql or HypersonicSQL. HypersonicSQL version 1.8.0 is the default"},{"type":"add","old":null,"new":151,"text":"\t\tchoice. It is possible to"},{"type":"add","old":null,"new":152,"text":"\t\teasily configure the application to use either database. Configuration"},{"type":"add","old":null,"new":153,"text":"\t\tdetails are provided in the Developer Instructions section."},{"type":"add","old":null,"new":154,"text":"\t</p>"},{"type":"add","old":null,"new":155,"text":""},{"type":"add","old":null,"new":156,"text":"\t<h3>Development Environment</h3>"},{"type":"add","old":null,"new":157,"text":"\t<p>"},{"type":"add","old":null,"new":158,"text":"\t\tA copy of the Spring runtime library jar file is provided with the"},{"type":"add","old":null,"new":159,"text":"\t\tsample application along with some of the other required jar files. The"},{"type":"add","old":null,"new":160,"text":"\t\tdeveloper will need to obtain the following tools externally, all of"},{"type":"add","old":null,"new":161,"text":"\t\twhich are freely available:"},{"type":"add","old":null,"new":162,"text":"\t</p>"},{"type":"add","old":null,"new":163,"text":""},{"type":"add","old":null,"new":164,"text":"\t<ul>"},{"type":"add","old":null,"new":165,"text":"\t  <li>Java SDK 1.5.x</li>"},{"type":"add","old":null,"new":166,"text":"\t  <li>Maven  2.0.10+</li>"},{"type":"add","old":null,"new":167,"text":"\t  <li>Ant  1.7.1 (for executing scripts, if needed, against the in-memory database)</li>"},{"type":"add","old":null,"new":168,"text":"\t  <li>Tomcat 6.x.x, or some other Java Servlet container</li>"},{"type":"add","old":null,"new":169,"text":"\t  <li>(Optional) MySQL 5.x with MySQL Connector/J 5.x</li>"},{"type":"add","old":null,"new":170,"text":"\t</ul>"},{"type":"add","old":null,"new":171,"text":""},{"type":"add","old":null,"new":172,"text":"\t<p>"},{"type":"add","old":null,"new":173,"text":"\t\t<strong>NOTE:</strong> The version numbers listed are those that were used"},{"type":"add","old":null,"new":174,"text":"\t\tin the development of the PetClinic application. Other versions of the same"},{"type":"add","old":null,"new":175,"text":"\t\ttools may or may not work."},{"type":"add","old":null,"new":176,"text":"\t</p>"},{"type":"add","old":null,"new":177,"text":""},{"type":"add","old":null,"new":178,"text":"\t<p>"},{"type":"add","old":null,"new":179,"text":"\t\tDownload links for the various tools needed are provided in the Developer"},{"type":"add","old":null,"new":180,"text":"\t\tInstructions section."},{"type":"add","old":null,"new":181,"text":"\t</p>"},{"type":"add","old":null,"new":182,"text":""},{"type":"add","old":null,"new":183,"text":"\t<h3>PetClinic Database</h3>"},{"type":"add","old":null,"new":184,"text":"\t<p>"},{"type":"add","old":null,"new":185,"text":"\t\tThe following is an overview of the database schema used in PetClinic."},{"type":"add","old":null,"new":186,"text":"\t\tDetailed field descriptions can be found in the"},{"type":"add","old":null,"new":187,"text":"\t\t<span style=\"font-weight: bold; font-style: italic;\">\"initDB.txt\"</span>"},{"type":"add","old":null,"new":188,"text":"\t\tSQL script files in the database-specific \"db\" sub-directories. All \"id\" key"},{"type":"add","old":null,"new":189,"text":"\t\tfields are of Java type <span style=\"font-weight: bold; font-style: italic;\">int</span>."},{"type":"add","old":null,"new":190,"text":"\t</p>"},{"type":"add","old":null,"new":191,"text":""},{"type":"add","old":null,"new":192,"text":"\t<p>"},{"type":"add","old":null,"new":193,"text":"\t\tTABLE: <span style=\"font-weight: bold; font-style: italic;\">owners</span><br>"},{"type":"add","old":null,"new":194,"text":"\t\t&nbsp;&nbsp;&nbsp; PRIMARY KEY <span style=\"font-weight: bold;\">id</span>"},{"type":"add","old":null,"new":195,"text":"\t</p>"},{"type":"add","old":null,"new":196,"text":""},{"type":"add","old":null,"new":197,"text":"\t<p>"},{"type":"add","old":null,"new":198,"text":"\t\tTABLE: <span style=\"font-weight: bold; font-style: italic;\">types</span><br>"},{"type":"add","old":null,"new":199,"text":"\t\t&nbsp;&nbsp;&nbsp; PRIMARY KEY <span style=\"font-weight: bold;\">id</span>"},{"type":"add","old":null,"new":200,"text":"\t</p>"},{"type":"add","old":null,"new":201,"text":""},{"type":"add","old":null,"new":202,"text":"\t<p>"},{"type":"add","old":null,"new":203,"text":"\t\tTABLE: <span style=\"font-weight: bold; font-style: italic;\">pets</span><br>"},{"type":"add","old":null,"new":204,"text":"\t\t&nbsp;&nbsp;&nbsp; PRIMARY KEY <span style=\"font-weight: bold;\">id</span><br>"}]}],"19.116